{
  "description": "Get detections from Sophos Fusion Security Operations",
  "docker_parameters": "sophos_fusion_detections_trigger",
  "name": "Get Sophos Fusion detections",
  "arguments": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "frequency": {
        "type": "integer",
        "description": "Batch frequency in seconds",
        "default": 60
      },
      "chunk_size": {
        "type": "integer",
        "description": "The max size of chunks for the batch processing",
        "default": 1000
      },
      "min_severity": {
        "type": "number",
        "description": "Only collect the detections with a severity greater than or equal to this value (from 0 to 1). Leave empty to collect all detections",
        "minimum": 0,
        "maximum": 1
      },
      "intake_server": {
        "description": "Server of the intake server (e.g. 'https://intake.sekoia.io')",
        "default": "https://intake.sekoia.io",
        "type": "string"
      },
      "intake_key": {
        "description": "Intake key to use when sending events",
        "type": "string"
      }
    },
    "required": [
      "frequency",
      "intake_key"
    ],
    "title": "Sophos Fusion detections",
    "type": "object"
  },
  "results": {},
  "uuid": "6faf46f3-41aa-4ee9-a02c-9f3757c1b9ca"
}
