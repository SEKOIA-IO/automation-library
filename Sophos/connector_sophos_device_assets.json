{
  "name": "Sophos EDR Device Assets",
  "description": "Fetch Sophos EDR endpoint device assets from the Sophos Central API",
  "uuid": "b3f7a1c2-4e8d-4b5a-9c6f-1d2e3f4a5b6c",
  "docker_parameters": "sophos_device_asset_connector",
  "type": "asset",
  "capability": "host_detection",
  "arguments": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "sekoia_base_url": {
        "description": "Sekoia base URL",
        "type": "string"
      },
      "frequency": {
        "type": "integer",
        "description": "Batch frequency in seconds"
      },
      "sekoia_api_key": {
        "description": "API key to use from sekoia.io",
        "type": "string"
      },
      "batch_size": {
        "description": "Batch size for each request",
        "type": "integer"
      }
    },
    "required": ["sekoia_api_key"],
    "secrets": ["sekoia_api_key"],
    "internal": ["sekoia_base_url", "sekoia_api_key", "frequency", "batch_size"]
  }
}

