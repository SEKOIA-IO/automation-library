{
  "name": "ESET Device",
  "description": "Fetch ESET EDR device assets",
  "uuid": "bbc218bf-9cf4-4d77-8938-47cebe86801f",
  "docker_parameters": "eset_device_asset_connector",
  "type": "asset",
  "capability": "host_detection",
  "arguments": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "sekoia_base_url": {
        "description": "Sekoia base URL",
        "type": "string"
      },
      "frequency": {
        "type": "integer",
        "description": "Batch frequency in seconds",
        "minimum": 1,
        "default": 60
      },
      "sekoia_api_key": {
        "description": "API key to use from sekoia.io",
        "type": "string"
      },
      "batch_size": {
        "type": "integer",
        "description": "Number of assets to process in one batch",
        "minimum": 1,
        "default": 100
      }
    },
    "required": ["sekoia_base_url", "sekoia_api_key"]
  }
}
