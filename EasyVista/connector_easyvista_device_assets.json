{
  "name": "EasyVista Devices",
  "description": "Fetch the devices of the EasyVista Service Manager asset inventory",
  "uuid": "13159f29-0a58-49bb-98ae-78e02852e1b3",
  "docker_parameters": "easyvista_device_asset_connector",
  "type": "asset",
  "capability": "host_detection",
  "arguments": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "search": {
        "description": "Optional EasyVista search expression restricting the collected assets (e.g. CATALOG_ID:3544,3545)",
        "type": "string"
      },
      "sekoia_base_url": {
        "description": "Sekoia base URL",
        "type": "string"
      },
      "frequency": {
        "type": "integer",
        "description": "Batch frequency in seconds",
        "minimum": 10800,
        "default": 86400
      },
      "sekoia_api_key": {
        "description": "API key to use from sekoia.io",
        "type": "string"
      },
      "batch_size": {
        "type": "integer",
        "description": "Number of assets to process in one batch",
        "minimum": 1,
        "default": 100
      }
    },
    "required": [
      "sekoia_api_key"
    ],
    "secrets": [
      "sekoia_api_key"
    ],
    "internal": [
      "sekoia_base_url",
      "sekoia_api_key",
      "frequency",
      "batch_size"
    ]
  }
}
