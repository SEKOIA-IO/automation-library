{
  "name": "Run SSH command",
  "description": "Run a command line on a remote host over SSH and return its output and exit code",
  "uuid": "8cfb10e0-87b4-4df0-b6c7-8dc0e8861ed8",
  "docker_parameters": "run_ssh_command",
  "arguments": {
    "type": "object",
    "properties": {
      "command": {
        "description": "Command line to run on the remote host",
        "type": "string"
      },
      "host": {
        "description": "Overrides the host set in the account",
        "type": "string"
      },
      "timeout": {
        "description": "Maximum execution time, in seconds",
        "type": "integer",
        "default": 300
      },
      "fail_on_error": {
        "description": "Mark the action as failed when the exit code is not 0",
        "type": "boolean",
        "default": true
      }
    },
    "required": ["command"]
  },
  "results": {
    "type": "object",
    "properties": {
      "host": {"type": "string", "description": "Host the command ran on"},
      "exit_code": {"type": "integer", "description": "Exit code of the command"},
      "stdout": {"type": "string", "description": "Standard output"},
      "stderr": {"type": "string", "description": "Standard error"},
      "host_key_fingerprint": {"type": "string", "description": "SHA256 fingerprint of the server's host key"}
    }
  }
}
