{
  "description": "Ubika Cloud Protector Next Generation Traffic Logs",
  "docker_parameters": "ubika_cloud_protector_next_gen_traffic_logs",
  "name": "Fetch new traffic logs events from Ubika Cloud Protector Next Generation",
  "arguments": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "base_url": {
        "description": "API base URL",
        "type": "string",
        "default": "https://api.ubika.io/",
        "format": "uri"
      },
      "chunk_size": {
        "type": "integer",
        "description": "The size of chunks for the batch processing",
        "default": 1000,
        "minimum": 1,
        "maximum": 1000
      },
      "frequency": {
        "type": "integer",
        "description": "Batch frequency in seconds",
        "default": 60,
        "minimum": 10,
        "maximum": 60
      },
      "intake_server": {
        "description": "Server of the intake server",
        "type": "string",
        "default": "https://intake.sekoia.io"
      },
      "intake_key": {
        "description": "Intake key to use when sending traffic-log events",
        "type": "string"
      },
      "namespace": {
        "description": "Namespace",
        "type": "string"
      },
      "refresh_token": {
        "description": "Refresh API token",
        "type": "string"
      },
      "start_time": {
        "description": "The number of hours from which events should be queried",
        "type": "integer",
        "default": 1,
        "minimum": 0
      },
      "timedelta": {
        "description": "The temporal shift, in the past, in minutes, the connector applies when fetching the events",
        "type": "integer",
        "default": 5,
        "minimum": 1
      }
    },
    "required": [
      "intake_key",
      "namespace",
      "refresh_token"
    ],
    "secrets": [
      "refresh_token"
    ],
    "title": "The configuration to fetch new traffic logs",
    "type": "object"
  },
  "uuid": "d36f495c-8b09-4a5c-9f69-1cfb9eebee7a"
}
