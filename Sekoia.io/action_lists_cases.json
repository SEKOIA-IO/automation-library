{
  "uuid": "ac749619-3763-4029-b276-d13d9df9824f",
  "name": "Search Cases",
  "docker_parameters": "list_cases",
  "description": "find cases that match your filters",
  "arguments": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "list_cases",
    "properties": {
      "match[community_uuid]": {
        "in": "query",
        "type": "string"
      },
      "match[status_uuid]": {
        "in": "query",
        "type": "string"
      },
      "match[status_name]": {
        "in": "query",
        "type": "string"
      },
      "date[created_at]": {
        "in": "query",
        "type": "string"
      },
      "date[updated_at]": {
        "in": "query",
        "type": "string",
        "description": "Update date of the cases, as a range (e.g. 2026-10-01T00:00:00Z,2026-10-31T23:59:59Z)"
      },
      "match[created_by]": {
        "in": "query",
        "type": "string"
      },
      "match[tags]": {
        "in": "query",
        "type": "string"
      },
      "match[assignees]": {
        "in": "query",
        "type": "string"
      },
      "match[title]": {
        "in": "query",
        "type": "string",
        "description": "Titles of the cases, separated by commas. Case insensitive, `*` matches any text"
      },
      "match[short_id]": {
        "in": "query",
        "type": "string",
        "description": "Short IDs of the cases, separated by commas"
      },
      "match[priority]": {
        "in": "query",
        "type": "string",
        "description": "Priorities of the cases (low, medium, high), separated by commas"
      },
      "match[custom_priority]": {
        "in": "query",
        "type": "string",
        "description": "UUIDs of the custom priorities, separated by commas"
      },
      "match[custom_status]": {
        "in": "query",
        "type": "string",
        "description": "UUIDs of the custom statuses, separated by commas"
      },
      "match[verdict]": {
        "in": "query",
        "type": "string",
        "description": "UUIDs of the verdicts, separated by commas"
      },
      "match[custom_field]": {
        "in": "query",
        "type": "string",
        "description": "Custom field values, as `field_uuid:value` (e.g. 123e4567-e89b-12d3-a456-426614174000:INC0012345), or a field UUID alone to match the cases where the field is set. Separated by commas"
      },
      "limit": {
        "in": "query",
        "type": "integer",
        "minimum": 1,
        "default": 20,
        "maximum": 100
      },
      "offset": {
        "in": "query",
        "type": "integer"
      },
      "sort": {
        "in": "query",
        "type": "string"
      },
      "direction": {
        "in": "query",
        "type": "string"
      }
    }
  },
  "results": {
    "type": "object",
    "properties": {
      "total": {
        "type": "integer",
        "format": "int32"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "uuid": {
              "type": "string",
              "format": "uuid"
            },
            "short_id": {
              "type": "string"
            },
            "created_at": {
              "type": "string"
            },
            "created_by": {
              "type": "string"
            },
            "created_by_type": {
              "type": "string"
            },
            "updated_at": {
              "type": "string"
            },
            "updated_by": {
              "type": "string"
            },
            "updated_by_type": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "priority": {
              "default": "medium",
              "description": "low|medium|high"
            },
            "status": {
              "type": "string"
            },
            "status_uuid": {
              "type": "string",
              "format": "uuid"
            },
            "community_uuid": {
              "type": "string",
              "format": "uuid"
            },
            "subscribers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "avatar_uuid": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "type": {
                    "type": "string"
                  }
                },
                "required": [
                  "avatar_uuid",
                  "type"
                ]
              }
            },
            "tags": {
              "type": "array",
              "description": "List of tags associated to the case",
              "items": {
                "type": "string"
              }
            },
            "number_of_comments": {
              "type": "integer"
            },
            "first_seen_at": {
              "type": "string",
              "format": "date-time",
              "x-nullable": true,
              "description": "Date and time of the first case event"
            },
            "last_seen_at": {
              "type": "string",
              "format": "date-time",
              "x-nullable": true,
              "description": "Date and time of the last case event"
            },
            "manual": {
              "type": "boolean",
              "x-nullable": true,
              "description": "if True, indicates that the case was created manually"
            },
            "is_supplied": {
              "type": "boolean",
              "x-nullable": true,
              "description": "if True, indicates that alerts can be automatically added to the case"
            },
            "verdict_uuid": {
              "type": "string",
              "format": "uuid",
              "x-nullable": true,
              "description": "UUID of the verdict associated to the case"
            },
            "custom_status_uuid": {
              "type": "string",
              "format": "uuid",
              "x-nullable": true,
              "description": "UUID of the custom status associated to the case"
            },
            "custom_priority_uuid": {
              "type": "string",
              "format": "uuid",
              "x-nullable": true,
              "description": "UUID of the priority associated to the case"
            }
          }
        }
      }
    },
    "required": [
      "community_uuid",
      "created_at",
      "created_by",
      "created_by_type",
      "short_id",
      "status",
      "status_uuid",
      "title",
      "uuid"
    ]
  },
  "slug": "search_cases"
}