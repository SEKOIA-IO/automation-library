      },
      "updated_by_type": {
        "type": "string",
        "description": "Type of the profile that last updated the alert (e.g. `application`, `avatar`)."
      },
      "title": {
        "type": "string",
        "description": "Human-readable title of the alert."
      },
      "target": {
        "type": "string",
