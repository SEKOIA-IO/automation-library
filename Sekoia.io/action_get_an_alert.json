{
  "uuid": "8d189665-5401-4098-8d60-944de9a6199a",
  "name": "Get Alert",
  "docker_parameters": "get-alerts/{uuid}",
  "description": "Retrieve the definition of an alert",
  "arguments": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "get_an_alert",
    "properties": {
      "uuid": {
        "type": "string",
        "in": "path",
        "description": "UUID of the alert to retrieve."
      },
      "stix": {
        "in": "query",
        "type": "boolean",
        "description": "If true, include the full STIX 2 bundle in the response (default: false)."
      },
      "cases": {
        "in": "query",
        "type": "boolean",
        "description": "Fetch the cases associated with this alert in addition (default: false)",
        "default": false
      }
    },
    "required": [
      "uuid"
    ]
  },
  "results": {
    "type": "object",
    "properties": {
      "urgency": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "integer",
            "format": "int32"
          },
          "current_value": {
            "type": "integer",
            "format": "int32"
          },
          "value": {
            "type": "integer",
            "format": "int32"
          },
          "criticity": {
            "type": "integer",
            "format": "int32"
          },
          "display": {
            "type": "string"
          }
        }
      },
      "history": {
        "type": "array",
        "description": "Ordered list of modifications made to the alert (status changes, field updates, assignments, etc.).",
        "items": {
          "type": "object",
          "properties": {
            "urgency": {
              "type": "object",
              "properties": {
                "previous_value": {
                  "type": "integer",
                  "format": "int32"
                },
                "value": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            },
            "created_by": {
              "type": "string"
            },
            "kill_chain": {
              "type": "object",
              "properties": {
                "previous_short_id": {
                  "type": "string"
                },
                "uuid": {
                  "type": "string"
                },
                "short_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            },
            "countermeasure_action_step": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            },
            "entry_type": {
              "type": "string"
            },
            "comment": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                },
                "uuid": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "display_name": {
                  "type": "string"
                }
              }
            },
            "created_at": {
              "type": "integer",
              "format": "int32"
            },
            "details": {
              "type": "object",
              "properties": {
                "previous_value": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            },
            "alert_type": {
              "type": "object",
              "properties": {
                "previous_category": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "previous_value": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            },
            "alert": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                },
                "previous_status": {
                  "type": "string"
                }
              }
            },
            "created_by_type": {
              "type": "string"
            },
            "history_comments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "created_by": {
                    "type": "string",
                    "description": "The identifier of the creator of the comment"
                  },
                  "content": {
                    "type": "string",
                    "description": "Content of the comment"
                  },
                  "author": {
                    "type": "string",
                    "description": "Author of the comment"
                  },
                  "date": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "created_by_type": {
                    "type": "string",
                    "description": "The type of the creator of the comment"
                  },
                  "uuid": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Identifier of the comment"
                  }
                },
                "required": [
                  "author",
                  "content",
                  "created_by",
                  "created_by_type",
                  "date",
                  "uuid"
                ]
              }
            },
            "uuid": {
              "type": "string"
            },
            "countermeasure": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                },
                "uuid": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "is_incident": {
        "type": "boolean"
      },
      "assets": {
        "type": "array",
        "description": "UUIDs of the assets involved in the alert.",
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "countermeasures": {
        "type": "array",
        "description": "Response actions (countermeasures) recommended or applied in reaction to the alert. Each countermeasure has a name, a description, a list of concrete action steps to execute, and a lifecycle status (pending → activated or denied). They can originate from three sources, reflected in the `type` field: `text` (free-form analyst note, e.g. 'Isolate the affected host'), `intelligence_center` (a course of action sourced from SEKOIA.IO's threat intelligence, e.g. 'Block IOC X on your firewall'), or `openc2` (a machine-readable OpenC2 command sent to a security actuator). Included by default; opt out with `?countermeasures=false`.",
        "items": {
          "type": "object",
          "properties": {
            "action_steps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "description": "Status of the action step"
                  },
                  "created_by": {
                    "type": "string",
                    "description": "UUID of profile that created the action step"
                  },
                  "action_order": {
                    "type": "string",
                    "description": "Position in the execution order of action steps"
                  },
                  "denied_by": {
                    "type": "string",
                    "description": "UUID of profile that denied the action step"
                  },
                  "object": {
                    "type": "object",
                    "description": "Object associated to the action step"
                  },
                  "assignee": {
                    "type": "string",
                    "description": "UUID of the profile assigned to the progress of the action step"
                  },
                  "activated_by_type": {
                    "type": "string",
                    "description": "Type of the profile that activated the action step"
                  },
                  "comments": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "created_by": {
                          "type": "string",
                          "description": "The identifier of the creator of the comment"
                        },
                        "content": {
                          "type": "string",
                          "description": "Content of the comment"
                        },
                        "author": {
                          "type": "string",
                          "description": "Author of the comment"
                        },
                        "date": {
                          "type": "integer",
                          "format": "int32"
                        },
                        "created_by_type": {
                          "type": "string",
                          "description": "The type of the creator of the comment"
                        },
                        "uuid": {
                          "type": "string",
                          "format": "uuid",
                          "description": "Identifier of the comment"
                        }
                      },
                      "required": [
                        "author",
                        "content",
                        "created_by",
                        "created_by_type",
                        "date",
                        "uuid"
                      ]
                    }
                  },
                  "created_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Date the action step was created"
                  },
                  "activated_by": {
                    "type": "string",
                    "description": "UUID of profile that activated the action step"
                  },
                  "activated_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Date the action step was activated"
                  },
                  "description": {
                    "type": "string",
                    "description": "Description of the action step"
                  },
                  "denied_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Date the action step was denied"
                  },
                  "name": {
                    "type": "string",
                    "description": "Name of the action step"
                  },
                  "created_by_type": {
                    "type": "string",
                    "description": "Type of the profile that created the action step"
                  },
                  "denied_by_type": {
                    "type": "string",
                    "description": "Type of the profile that denied the action step"
                  }
                }
              }
            },
            "activated_by_type": {
              "type": "string",
              "description": "Type of the profile that activated the countermeasure"
            },
            "comments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "created_by": {
                    "type": "string",
                    "description": "The identifier of the creator of the comment"
                  },
                  "content": {
                    "type": "string",
                    "description": "Content of the comment"
                  },
                  "author": {
                    "type": "string",
                    "description": "Author of the comment"
                  },
                  "date": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "created_by_type": {
                    "type": "string",
                    "description": "The type of the creator of the comment"
                  },
                  "uuid": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Identifier of the comment"
                  }
                },
                "required": [
                  "author",
                  "content",
                  "created_by",
                  "created_by_type",
                  "date",
                  "uuid"
                ]
              }
            },
            "activated_at": {
              "type": "string",
              "format": "date-time",
              "description": "Date the countermeasure was activated"
            },
            "relevance": {
              "type": "integer",
              "format": "int32",
              "description": "Relevance of the countermeasure"
            },
            "denied_by_type": {
              "type": "string",
              "description": "Type of the profile that denied the countermeasure"
            },
            "status": {
              "type": "string",
              "description": "(deprecated) Status of the countermeasure"
            },
            "created_by": {
              "type": "string",
              "description": "UUID of profile that created the countermeasure"
            },
            "model_uuid": {
              "type": "string",
              "description": "UUID of the model from which this countermeasure has been created"
            },
            "activated_by": {
              "type": "string",
              "description": "UUID of profile that activated the countermeasure"
            },
            "description": {
              "type": "string",
              "description": "Description of the countermeasure"
            },
            "name": {
              "type": "string",
              "description": "Name of the countermeasure"
            },
            "uuid": {
              "type": "string",
              "description": "UUID of the countermeasure"
            },
            "duration": {
              "type": "string",
              "description": "Estimated duration to apply the countermeasures"
            },
            "alert_uuid": {
              "type": "string",
              "description": "UUID of the alert related to the countermeasure"
            },
            "denied_at": {
              "type": "string",
              "format": "date-time",
              "description": "Date the countermeasure was denied"
            },
            "created_by_type": {
              "type": "string",
              "description": "Type of the profile that created the countermeasure"
            },
            "course_of_action": {
              "type": "object",
              "description": "(deprecated) STIX2 object course of action"
            },
            "dynamic_relevance": {
              "type": "integer",
              "format": "int32",
              "description": "Dynamic relevance of the countermeasure"
            },
            "denied_by": {
              "type": "string",
              "description": "UUID of profile that denied the countermeasure"
            },
            "assignee": {
              "type": "string",
              "description": "UUID of the profile assigned to the progress of the countermeasure"
            },
            "created_at": {
              "type": "string",
              "format": "date-time",
              "description": "Date the countermeasure was created"
